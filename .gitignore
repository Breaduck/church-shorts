# 파이썬 가상환경
venv/
__pycache__/
*.pyc

# 생성물 (대용량 영상/오디오/전사 데이터 - 저장소에 안 올림)
output/
assets/cache/
# fonts.py가 원본 폰트들을 모아 만드는 통합 폴더(파생물) - 재생성되므로 커밋 안 함
assets/_allfonts/
# 편집기 글씨체 원본 모음(대용량 폰트 바이너리, 라이선스 혼재) - 로컬 전용
글씨체/

# Cloudflare Wrangler 로컬 빌드 캐시/상태
.wrangler/

# 민감정보
.env
secrets/

# Microsoft 폰트만 제외 (Windows 시스템 폰트 재배포 라이선스 불명확 - 로컬에서 직접 복사해서 사용)
# Pretendard는 OFL 오픈소스 라이선스라 저장소에 포함해도 안전함
assets/fonts/malgun*.ttf

# OS/에디터
.DS_Store
Thumbs.db

# 로컬 도구 상태
.claude/

# editor.bat 자동 업데이트가 각 PC에 기록하는 "설치된 커밋" 마커 - 로컬 전용
.installed_commit

# 참고용으로 받은 타인 콘텐츠 스크린샷 (저작권 불명확 - 저장소에 올리지 않음)
유튜브 이미지.jpg
유튜브 이미지 2.jpg

# 작업 중 생기는 일회성 파일(스크래치 스크립트·서버 로그·테스트 영상·참고 스크린샷)
